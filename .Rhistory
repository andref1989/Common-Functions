str(module_comp)
module_comp$Module1 <- unlist(lapply(module_comp[,1], function(x) unlist(strsplit(x,"\\."))[2]))
module_comp$Module2 <- unlist(lapply(module_comp[,2], function(x) unlist(strsplit(x,"\\."))[2]))
head(module_comp)
module_comp$Network1 <- unlist(lapply(module_comp[,1], function(x) unlist(strsplit(x,"\\."))[1])); module_comp$Network2 <- unlist(lapply(module_comp[,2], function(x) unlist(strsplit(x,"\\."))[1]))
module_comp2 <- dplyr::filter(module_comp, Network1!=Network2)
str(module_comp2)
module_comp2 <- dplyr::filter(module_comp, Network1!=Network2, Module1==Module2))
module_comp2 <- dplyr::filter(module_comp, Network1!=Network2, Module1==Module2)
