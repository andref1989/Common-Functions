OS_dir <- "~/Pathos_Projects_Data/p0085_Rain_Diligence/MDM2_Key_Driver_Analysis/"
os_files <- list.files(OS_dir,"results_os.csv")

module_OS_list <- list()
for(i in os_files){
    tranche <- paste0("result_", last(unlist(strsplit(gsub("_results_os.csv","",i),"_"))))
    int <- read.csv(paste0(OS_dir, i))
    int <- dplyr::select(int, Network=network, pathway=module,NES=odds_ratio,padj=p_value_adj,Signature=os_effect)
    int$Tranche <- tranche
    int$Signature <- gsub("worse", "Worse_OS",int$Signature)
    int$Signature <- gsub("better", "Better_OS",int$Signature)
    module_OS_list[[tranche]] <- int}

